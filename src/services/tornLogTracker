function isRunning() {
  return intervalHandle !== null;
}

function startTornLogTracker(client, options) {
  if (intervalHandle) return false; // läuft bereits

  const { apiKey, userId = "", channelName = "LOGS", intervalMs = 60000, categories = "" } = options;
  if (!apiKey) throw new Error("[TornLogTracker] apiKey fehlt.");

  const opts = { apiKey, userId, channelName, categories };
  poll(client, opts); // sofort einmal prüfen
  intervalHandle = setInterval(() => poll(client, opts), intervalMs);
  return true;
}

function stopTornLogTracker() {
  if (!intervalHandle) return false; // lief nicht
  clearInterval(intervalHandle);
  intervalHandle = null;
  return true;
}

module.exports = { startTornLogTracker, stopTornLogTracker, isRunning };
