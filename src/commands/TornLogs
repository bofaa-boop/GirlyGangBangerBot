// commands/tornlogs.js
const { SlashCommandBuilder, PermissionFlagsBits } = require("discord.js");
const { startTornLogTracker, stopTornLogTracker, isRunning } = require("../tornLogTracker");

module.exports = {
  data: new SlashCommandBuilder()
    .setName("tornlogs")
    .setDescription("Torn.com Log-Tracker steuern")
    .setDefaultMemberPermissions(PermissionFlagsBits.ManageGuild)
    .addSubcommand((sub) => sub.setName("start").setDescription("Log-Tracking starten"))
    .addSubcommand((sub) => sub.setName("stop").setDescription("Log-Tracking stoppen"))
    .addSubcommand((sub) => sub.setName("status").setDescription("Status anzeigen")),

  async execute(interaction) {
    const sub = interaction.options.getSubcommand();

    if (sub === "start") {
      const started = startTornLogTracker(interaction.client, {
        apiKey: process.env.TORN_API_KEY,
        channelName: "LOGS",
        intervalMs: 60000,
      });
      await interaction.reply(
        started ? "✅ Torn-Log-Tracking gestartet." : "⚠️ Läuft bereits."
      );
    } else if (sub === "stop") {
      const stopped = stopTornLogTracker();
      await interaction.reply(stopped ? "🛑 Torn-Log-Tracking gestoppt." : "⚠️ Lief nicht.");
    } else if (sub === "status") {
      await interaction.reply(isRunning() ? "🟢 Läuft gerade." : "🔴 Gestoppt.");
    }
  },
};
